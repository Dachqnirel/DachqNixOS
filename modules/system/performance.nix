# Оптимизации: быстрее загрузка и запуск программ, нет зависаний от нехватки памяти
{ pkgs, ... }:

{
  # ── Память ──────────────────────────────────────────────────────────
  # Сжатый своп в оперативке: при нехватке памяти система не «встаёт колом»
  zramSwap.enable = true;

  # Если память всё же кончается — убить самый жадный процесс, а не зависнуть
  services.earlyoom.enable = true;

  boot.kernel.sysctl = {
    # С zram выгоднее сжимать неактивные данные программ, чем выкидывать
    # из памяти файлы программ — тогда повторный запуск мгновенный
    "vm.swappiness" = 180;
    "vm.page-cluster" = 0;          # zram читает по одной странице, так быстрее
    # Дольше держать в памяти информацию о файлах и папках
    "vm.vfs_cache_pressure" = 50;
  };


  # ── Загрузка системы ────────────────────────────────────────────────
  # Не ждать подключения к сети при загрузке
  systemd.services.NetworkManager-wait-online.enable = false;


  # Раз в неделю TRIM для SSD — диск не замедляется со временем
  services.fstrim.enable = true;
}
